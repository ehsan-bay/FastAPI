# Copy to .env and change every value marked CHANGE.
# Generate secrets with:  openssl rand -hex 32

SECRET_KEY=CHANGE-me-openssl-rand-hex-32
POSTGRES_DB=salamat
POSTGRES_USER=salamat
POSTGRES_PASSWORD=CHANGE-me-strong-password

# Public domain (needed only for the "https" profile with Caddy)
DOMAIN=health.example.com
ACME_EMAIL=you@example.com

# App port on the host. 127.0.0.1 = reachable only through Caddy/Nginx (recommended).
APP_BIND=127.0.0.1
APP_PORT=8000

# 1 = also install the optional chat LLM (~400 MB, needs ~1 GB extra RAM)
WITH_LLM=0
LLM_THREADS=2
CORS_ORIGINS=*

# Prebuilt image from GitHub (use when the server can't reach PyPI/Google to build):
# APP_IMAGE=ghcr.io/ehsan-bay/salamat-ai:latest

# Admin panel login (https://your-site/admin). Created on first start if no admin exists.
ADMIN_EMAIL=admin@salamatyar.ir
ADMIN_PASSWORD=CHANGE-me-admin-password

# Bank gateway (IPG). Only the first start uses these; afterwards change them in the admin panel (Settings).
# IPG_PAYMENT_URL=http://192.168.141.45:1212/_ipgw_//payment/simple/
# IPG_MID=41642444
# IPG_REST_URL=            # base URL of merchantLogin / verifyMerchantTrans / reverseTransaction
# IPG_USERNAME=
# IPG_PASSWORD=
# PUBLIC_URL=https://salamatyar.tosantechno.ir   # used in redirectURL; empty = from the request
